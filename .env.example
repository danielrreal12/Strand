# OAuth client from a Google Cloud project you control.
# Enable the Gmail API. Consent screen: External, Testing, and add only your Gmail as a test user.
# Scope: https://www.googleapis.com/auth/gmail.readonly
# Redirect URI: http://localhost:3847/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string used to encrypt the refresh token cookie. At least 16 characters.
GMAIL_TOKEN_SECRET=

# Extra private hosts, comma-separated. Localhost is already allowed.
# Do not add trycloudflare, ngrok, or any other public tunnel.
GMAIL_ALLOWED_HOSTS=
